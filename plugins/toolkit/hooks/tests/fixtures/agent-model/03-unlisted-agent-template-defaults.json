{
  "name": "an agent absent from the user file applies the template defaults",
  "stdin": { "tool_name": "Agent", "tool_input": { "description": "d", "prompt": "p", "subagent_type": "toolkit:code-reviewer" } },
  "env": { "TOOLKIT_MODELS_FILE": "fixtures/agent-model/aux/models.json", "TOOLKIT_MODELS_TEMPLATE": "fixtures/agent-model/aux/template.json" },
  "expect_exit": 0,
  "expect_stdout_contains": ["updatedInput", "\"model\":\"fable\"", "\"effort\":\"low\""]
}
