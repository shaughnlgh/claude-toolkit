{
  "name": "an alias model is sent unchanged with no alias note",
  "stdin": { "tool_name": "Agent", "tool_input": { "description": "d", "prompt": "p", "subagent_type": "explorer" } },
  "env": { "TOOLKIT_MODELS_FILE": "fixtures/agent-model/aux/models.json", "HOME": "fixtures/agent-model/aux", "TOOLKIT_MODELS_TEMPLATE": "fixtures/agent-model/aux/template.json" },
  "expect_exit": 0,
  "expect_stdout_contains": ["\"model\":\"sonnet\""],
